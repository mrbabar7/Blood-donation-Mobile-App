{
  "expo": {
    "name": "Blood Donation",
    "slug": "blood-donation-app",
    "version": "1.0.0",
    "scheme": "blooddonation",
    "orientation": "portrait",
    "icon": "./assets/blood-donation-logo.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/blood-donation-logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/blood-donation-logo.jpeg",
        "backgroundImage": "./assets/blood-donation-logo.jpeg",
        "monochromeImage": "./assets/blood-donation-logo.jpeg"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gemini-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ]
  }
}
